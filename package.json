{
  "name": "moje-financije-native",
  "version": "3.0.0",
  "description": "Izvorna Qt desktop aplikacija u JavaScriptu s lokalnim SQLiteom i Firebaseom",
  "type": "module",
  "main": "src/app.mjs",
  "scripts": {
    "start": "node node_modules/@nodegui/nodegui/scripts/qode.js src/app.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@nodegui/nodegui": "0.74.2",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0"
  },
  "pkg": {
    "scripts": ["src/**/*.mjs"],
    "assets": ["node_modules/@nodegui/nodegui/**/*"],
    "targets": ["node20-win-x64"],
    "outputPath": "release"
  }
}
